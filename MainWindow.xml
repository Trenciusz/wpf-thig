<Window x:Class="AtletikaRajtszamok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4DDE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#19324D"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#19324D"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SmallNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#52657A"/>
        </Style>

        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellLeft" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="CellCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" Margin="2,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0">
            <DockPanel LastChildFill="True">

                <Button x:Name="btnRegisztral" DockPanel.Dock="Bottom"
                        Content="REGISZTRÁL" Height="36" Margin="0,12,0,0"
                        Background="#DDEBFA"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="Regisztral_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Új versenyző"  Margin="0,0,0,12"/>

                        <TextBlock Text="Versenyző neve:"/>
                        <TextBox x:Name="txtNev" Height="32" Margin="0,0,0,12"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"/>

                        <TextBlock Text="Versenyszám:"/>
                        <ComboBox x:Name="cmbVersenyszam" Height="32" Margin="0,0,0,12"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  IsEditable="False" SelectedIndex="-1">
                            <ComboBoxItem Content="100 m"/>
                            <ComboBoxItem Content="200 m"/>
                            <ComboBoxItem Content="400 m"/>
                            <ComboBoxItem Content="800 m"/>
                            <ComboBoxItem Content="1500 m"/>
                            <ComboBoxItem Content="Távolugrás"/>
                            <ComboBoxItem Content="Magasugrás"/>
                            <ComboBoxItem Content="Súlylökés"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Nem:" VerticalAlignment="Center" Foreground="#19324D" Margin="0,0,24,0"/>
                            <RadioButton x:Name="rbFerfi" GroupName="Nem" Content="Férfi"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         IsChecked="False" Margin="0,0,40,0"/>
                            <RadioButton x:Name="rbNo" GroupName="Nem" Content="Nő"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         IsChecked="False"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Életkor:" Foreground="#19324D" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtEletkor" Text="18 év" FontWeight="Bold" Foreground="#1F5C99"
                                       HorizontalAlignment="Right" Margin="0,0,16,0"/>
                        </Grid>
                        <Slider x:Name="sldEletkor"
                                Minimum="18" Maximum="90" Value="18"
                                SmallChange="1" LargeChange="1"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                Margin="6,4,6,0"
                                ValueChanged="Eletkor_Valtozott"/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="18" HorizontalAlignment="Left"/>
                            <TextBlock Text="90" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </Grid>

                        <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,4"/>
                        <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs (OR)" IsChecked="False" Margin="0,4,0,0"/>
                        <CheckBox x:Name="chkVB" Content="Világcsúcs (VR)" IsChecked="False" Margin="0,4,0,0"/>
                        <CheckBox x:Name="chkEB" Content="Európa-csúcs (ER)" IsChecked="False" Margin="0,4,0,12"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Igényelt rajtszám:" Foreground="#19324D"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="txtRajtszam" Grid.Column="1" Height="32" Text=""
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                        </Grid>
                        <TextBlock Text="Üres mező: automatikus kiosztás."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Regisztrált versenyzők" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Eredményszűrő:" Foreground="#52657A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cmbRekordSzuro" Width="240" Height="32"
                              VerticalContentAlignment="Center"
                              IsEditable="False" SelectedIndex="0"
                              SelectionChanged="Szuro_Valtozott">
                        <ComboBoxItem Content="Összes"/>
                        <ComboBoxItem Content="OR - olimpiai csúcs"/>
                        <ComboBoxItem Content="VR - világcsúcs"/>
                        <ComboBoxItem Content="ER - Európa-csúcs"/>
                    </ComboBox>
                </StackPanel>

                <DataGrid x:Name="dgVersenyzok" Grid.Row="2"
                          ItemsSource="{Binding Versenyzok, Mode=OneWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E3E9F0"
                          RowHeight="32"
                          ColumnHeaderHeight="38"
                          AlternationCount="2"
                          AlternatingRowBackground="#F4F7FB"
                          RowBackground="White"
                          Background="White"
                          BorderBrush="#D4DDE7" BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#19324D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Width="88"
                                            Binding="{Binding Rajtszam, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="Név" Width="*"
                                            Binding="{Binding Nev, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="Versenyszám" Width="160"
                                            Binding="{Binding Versenyszam, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="Nem" Width="70"
                                            Binding="{Binding Nem, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="Életkor" Width="80"
                                            Binding="{Binding Eletkor, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridCheckBoxColumn Header="OR" Width="80"
                                                Binding="{Binding OR, Mode=OneWay}"
                                                ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="VR" Width="80"
                                                Binding="{Binding VR, Mode=OneWay}"
                                                ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="ER" Width="80"
                                                Binding="{Binding ER, Mode=OneWay}"
                                                ElementStyle="{StaticResource CellCheck}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="OR = olimpiai csúcs" Margin="0,0,24,0"/>
                    <TextBlock Text="VR = világcsúcs"  Margin="0,0,24,0"/>
                    <TextBlock Text="ER = Európa-csúcs"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtLetszam" Grid.Column="0" Text="Látható: 0 / Összesen: 0"
                           Foreground="#52657A" VerticalAlignment="Center"/>
                <Button x:Name="btnMentes" Grid.Column="1" Content="FÁJLBA MENTÉS"
                        Width="210" Height="32" VerticalAlignment="Center"
                        Click="Mentes_Click"/>
                <Button x:Name="btnBetoltes" Grid.Column="2" Content="FÁJLBÓL BETÖLTÉS"
                        Width="210" Height="32" Margin="16,0,0,0" VerticalAlignment="Center"
                        Click="Betoltes_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
